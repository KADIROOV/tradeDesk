# Copy to .env.local for local development. Never commit real values.

# --- Browser (safe to expose; Row Level Security protects the data) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Server only (Vercel functions). NEVER prefix these with VITE_ ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# At least 32 random characters. Changing it invalidates every sync key.
SYNC_KEY_PEPPER=generate-with-openssl-rand-base64-48
# Comma-separated origins allowed to call /api from a browser.
ALLOWED_ORIGINS=https://tradezdesk.vercel.app,http://localhost:5173
PUBLIC_APP_URL=https://tradezdesk.vercel.app
